# GBrain local provider configuration
# Copy to .env and fill in real values. Never commit .env.

# DeepSeek chat models:
# - deepseek-v4-flash: simple/fast tasks
# - deepseek-v4-pro: complex/reasoning-heavy tasks
DEEPSEEK_API_KEY=

# DashScope embeddings.
# China-region Model Studio keys must use the China endpoint below; without this
# override GBrain uses the international endpoint and the key can be rejected.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: database override for Postgres/Supabase installs.
# GBRAIN_DATABASE_URL=
